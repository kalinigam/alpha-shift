---
/*
 * The hero dot-cluster (Synthesis reference): "what's already known + the possibilities."
 * Each dot: [cx, cy, r, class, opacity]. Colour classes: c-i ink, c-o orange, c-l lavender,
 * c-g green, c-y yellow. Base opacity is passed as the --op custom property (NOT the CSS
 * `opacity` property) so the possibility-chip emphasis rule can override it.
 */
type Dot = [number, number, number, string, number];

const dots: Dot[] = [
  [55, 30, 3.2, 'c-i', 0.7], [66, 34, 2.4, 'c-o', 1], [48, 40, 4, 'c-i', 0.5],
  [60, 44, 2.7, 'c-l', 1], [72, 42, 3, 'c-i', 0.6], [40, 50, 2.2, 'c-g', 1],
  [52, 52, 5, 'c-i', 0.85], [63, 55, 3.4, 'c-o', 1], [75, 52, 2.4, 'c-i', 0.5],
  [46, 60, 2.8, 'c-y', 1], [58, 62, 3, 'c-i', 0.6], [69, 63, 4, 'c-i', 0.7],
  [80, 58, 2.1, 'c-l', 1], [36, 44, 1.8, 'c-i', 0.4], [84, 48, 2.2, 'c-i', 0.45],
  [50, 70, 2.4, 'c-g', 1], [62, 72, 2, 'c-i', 0.5], [73, 73, 3, 'c-o', 1],
  [43, 34, 1.6, 'c-i', 0.4], [30, 56, 1.8, 'c-i', 0.35], [88, 64, 1.8, 'c-i', 0.4],
  [57, 22, 1.6, 'c-i', 0.4], [67, 26, 1.6, 'c-y', 1], [78, 34, 2, 'c-i', 0.5],
  [34, 66, 2.1, 'c-l', 1], [45, 78, 1.8, 'c-i', 0.45], [60, 82, 2.2, 'c-i', 0.5],
  [71, 82, 1.7, 'c-g', 1], [82, 74, 2, 'c-i', 0.45], [90, 54, 1.4, 'c-i', 0.35],
  [26, 48, 1.4, 'c-i', 0.3], [53, 46, 1.8, 'c-o', 1], [68, 48, 1.8, 'c-i', 0.5],
  [55, 58, 1.8, 'c-l', 1], [48, 50, 1.5, 'c-y', 1], [64, 66, 1.6, 'c-i', 0.5],
  [77, 62, 1.6, 'c-i', 0.45], [42, 68, 1.5, 'c-g', 1], [59, 36, 1.6, 'c-i', 0.45],
  [33, 38, 1.3, 'c-i', 0.3],
];

const { note } = Astro.props as { note?: string };
---

<div class="cluster-wrap" aria-hidden="true">
  <svg class="cluster" id="cluster" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
    {dots.map(([cx, cy, r, cls, op]) => (
      <circle class={cls} cx={cx} cy={cy} r={r} style={`--op:${op}`} />
    ))}
  </svg>
  {note && <p class="cluster-note">{note}</p>}
</div>
