---
// Programmes — internal page. Seven sketchnote-led programmes as rounded cards.
// Each card: name + one-line promise + mono number + "Take a closer look" affordance.
// The overlay copy (recognition · meaning · Try this · optional note) is revealed in
// place via a native <details>/<summary> accordion — zero-JS, fully accessible.
// Copy is verbatim from ../data/programmes.ts. The sketchnote field is a drawing brief
// and is intentionally NOT rendered.
import Internal from '../layouts/Internal.astro';
import { programmes, depthLine } from '../data/programmes.ts';
---

<Internal
  title="Programmes — Alpha Shift"
  description="Seven programmes for thinking better, communicating clearly, and stepping up. Take a closer look — then choose the depth that fits."
>
  <!-- ============ HEADER ============ -->
  <section class="phead">
    <div class="wrap">
      <span class="tag" data-rise>The programmes</span>
      <h1 data-rise>Seven ways to <span class="serif">shift.</span></h1>
      <p class="lede" data-rise>
        Each one starts with a real situation — and a small, usable change in how you
        approach it. Take a closer look at any programme, then <span class="serif">choose the depth</span> that fits.
      </p>
    </div>
  </section>

  <!-- ============ PROGRAMME CARDS ============ -->
  <section class="progs">
    <div class="wrap">
      <div class="grid">
        {programmes.map((p) => (
          <details class="card" name="programme" data-rise>
            <summary>
              <span class="no">{p.no}</span>
              <span class="cardtop">
                <span class="pname">{p.name}</span>
                <span class="promise">{p.promise}</span>
              </span>
              <span class="closer">
                <span class="closer-label">Take a closer look</span>
                <span class="arr" aria-hidden="true">→</span>
              </span>
            </summary>

            <div class="overlay">
              <p class="recognition">{p.overlay.recognition}</p>

              <ul class="meaning">
                {p.overlay.meaning.map((m) => (<li>{m}</li>))}
              </ul>

              <div class="try">
                <span class="try-tag">Try this</span>
                <ol class="try-list">
                  {p.overlay.tryThis.map((t) => (<li>{t}</li>))}
                </ol>
              </div>

              {p.overlay.note && (<p class="note">{p.overlay.note}</p>)}

              <a class="take" href={`${import.meta.env.BASE_URL}explore/`}>Let’s explore <span class="arr" aria-hidden="true">→</span></a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DEPTH + CTA ============ -->
  <section class="depth is-dark">
    <div class="wrap">
      <span class="tag" data-rise>Choose the depth</span>
      <p class="depthline" data-rise>{depthLine}</p>
      <a class="btn" href={`${import.meta.env.BASE_URL}explore/`} data-rise>Let’s explore <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Internal>

<style>
  /* ===== HEADER ===== */
  .phead{padding:clamp(48px,10vh,120px) 0 clamp(30px,5vh,54px)}
  .phead h1{font-size:clamp(2.8rem,8vw,6rem);font-weight:600;letter-spacing:-.05em;line-height:.94;
    margin:clamp(20px,4vh,34px) 0 0}
  .phead h1 .serif{color:var(--orange)}
  .phead .lede{font-size:clamp(1.1rem,1.9vw,1.4rem);color:var(--muted);line-height:1.55;
    max-width:52ch;margin:clamp(22px,3.5vh,32px) 0 0}
  .phead .lede .serif{color:var(--ink)}

  /* ===== CARD GRID ===== */
  .progs{padding-block:clamp(20px,4vh,44px) clamp(70px,14vh,150px)}
  .progs .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(18px,2.4vw,30px)}
  @media(max-width:820px){.progs .grid{grid-template-columns:1fr}}

  .card{position:relative;background:#fff;border:1px solid var(--line);border-radius:22px;
    box-shadow:0 1px 2px rgba(20,19,17,.04);transition:box-shadow .3s ease,border-color .3s ease,transform .3s ease}
  .card:hover{box-shadow:0 1px 2px rgba(20,19,17,.05),0 22px 54px rgba(20,19,17,.08);border-color:#DAD6CD}
  .card[open]{box-shadow:0 1px 2px rgba(20,19,17,.05),0 30px 70px rgba(20,19,17,.11);border-color:#D6D1C7}

  /* summary = the card face */
  .card summary{list-style:none;cursor:pointer;display:grid;
    grid-template-columns:auto 1fr;gap:0 clamp(16px,2vw,26px);
    padding:clamp(26px,3vw,40px);align-items:start;outline:none}
  .card summary::-webkit-details-marker{display:none}
  .card summary:focus-visible{border-radius:22px;box-shadow:0 0 0 2px var(--orange)}

  .card .no{font-family:var(--mono);font-size:13px;letter-spacing:.06em;color:var(--orange-deep);
    padding-top:.35em;transition:color .2s}
  .card:hover .no,.card[open] .no{color:var(--orange)}
  .card .cardtop{min-width:0}
  .card .pname{display:block;font-family:var(--mono);font-size:12px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--muted);margin:.15em 0 .55em}
  .card .promise{display:block;font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:500;
    letter-spacing:-.025em;line-height:1.12;color:var(--ink)}

  /* "Take a closer look" affordance — spans under the copy, aligned with it */
  .card .closer{grid-column:2;display:inline-flex;align-items:center;gap:.5em;margin-top:clamp(20px,2.6vh,30px);
    font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--orange-deep);transition:color .2s}
  .card:hover .closer{color:var(--orange)}
  .card .closer .arr{transition:transform .25s ease}
  .card:hover .closer .arr{transform:translateX(4px)}
  .card[open] .closer .arr{transform:rotate(90deg)}
  .card[open] .closer-label{opacity:.55}

  /* ===== OVERLAY (revealed) ===== */
  .card .overlay{padding:0 clamp(26px,3vw,40px) clamp(28px,3vw,40px);
    margin-left:clamp(0px,0px,0px)}
  @media(min-width:521px){
    /* align overlay text with the copy column (past the number gutter) */
    .card .overlay{padding-left:calc(clamp(26px,3vw,40px) + 13px + clamp(16px,2vw,26px))}
  }
  .card .overlay > *{margin-top:0}
  .card[open] .overlay{animation:ovin .5s cubic-bezier(.2,.6,.2,1) both}
  @keyframes ovin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  .card .recognition{margin:0 0 clamp(16px,2vh,22px);padding-top:clamp(4px,1vh,10px);
    border-top:1px solid var(--line);
    font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,1.9vw,1.4rem);
    line-height:1.32;color:var(--ink);padding-top:clamp(18px,2.4vh,26px)}

  .card .meaning{list-style:none;margin:0 0 clamp(22px,3vh,30px);padding:0}
  .card .meaning li{font-size:clamp(1rem,1.5vw,1.12rem);color:var(--muted);line-height:1.45;
    padding:.28em 0}
  .card .meaning li:last-child{color:var(--ink);font-weight:500}

  .card .try{border-left:2px solid var(--orange);padding-left:clamp(16px,2vw,22px);
    margin:0 0 clamp(22px,3vh,28px)}
  .card .try-tag{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.18em;
    text-transform:uppercase;color:var(--orange-deep);margin:0 0 .7em}
  .card .try-list{list-style:none;margin:0;padding:0;counter-reset:t}
  .card .try-list li{font-size:clamp(1rem,1.6vw,1.18rem);color:var(--ink);line-height:1.4;padding:.2em 0}

  .card .note{margin:0 0 clamp(20px,3vh,26px);font-family:var(--mono);font-size:11.5px;
    letter-spacing:.02em;line-height:1.55;color:var(--muted);
    background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:12px 15px}

  .card .take{display:inline-flex;align-items:center;gap:.45em;font-weight:600;
    color:var(--orange-deep);border-bottom:1px solid var(--orange);padding-bottom:2px;transition:gap .2s}
  .card .take:hover{gap:.7em}
  .card .take .arr{color:var(--orange)}

  /* ===== DEPTH + CTA ===== */
  .depth{background:var(--ink);color:var(--paper);padding-block:clamp(80px,16vh,180px);text-align:center}
  .depth .tag{color:rgba(247,245,240,.6)}
  .depth .depthline{font-size:clamp(1.5rem,3.6vw,2.7rem);font-weight:500;letter-spacing:-.03em;
    line-height:1.28;color:var(--paper);max-width:24ch;margin:clamp(22px,3.5vh,34px) auto clamp(30px,5vh,44px)}
  .depth .btn{display:inline-flex;align-items:center;gap:.5em;background:var(--orange);color:#141311;
    font-weight:600;font-size:1.08rem;padding:17px 38px;border-radius:999px;
    box-shadow:0 10px 30px rgba(232,85,26,.28);transition:transform .2s,box-shadow .2s}
  .depth .btn:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(232,85,26,.34)}
  .depth .btn .arr{transition:transform .2s}
  .depth .btn:hover .arr{transform:translateX(4px)}

  @media(prefers-reduced-motion:reduce){
    .card[open] .overlay{animation:none}
    .card,.card .closer .arr,.card .take,.depth .btn{transition:none}
  }
</style>
