  /* ===== SKETCH SCENE â€” big unboxed sketch + two text beats + ambient gradient (kept off the sketch) ===== */
  .sk{position:relative;height:240vh}
  .sk .pin{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;align-items:center;background:var(--paper)}
  /* ambient flowing gradient â€” concentrated on the LEFT behind the text, not around the sketch */
  .sk .ambient{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .sk .ambient .gb{position:absolute;border-radius:50%;filter:blur(74px);animation-play-state:paused}
  .sk.live .ambient .gb{animation-play-state:running}
  .sk .gb.g1{width:42vw;height:42vw;background:var(--orange);opacity:.24;left:-16vw;top:-10vw;animation:skA 13s ease-in-out infinite}
  .sk .gb.g2{width:38vw;height:38vw;background:var(--yellow);opacity:.48;left:-2vw;bottom:-16vw;animation:skB 16s ease-in-out infinite}
  .sk .gb.g3{width:30vw;height:30vw;background:var(--lavender);opacity:.4;left:-6vw;top:34vh;animation:skC 15s ease-in-out infinite}
  .sk .wrap{position:relative;z-index:1;width:100%}
  .sk .grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:clamp(30px,5vw,80px);align-items:center}
  .sk .txt{position:relative;padding-left:clamp(20px,3vw,40px);min-height:46vh}
  .sk .fill{position:absolute;left:0;top:6px;bottom:6px;width:2px;background:var(--line);overflow:hidden}
  .sk .fill i{position:absolute;inset:0;background:var(--orange);transform:scaleY(0);transform-origin:top}
  .sk .beat{position:absolute;top:50%;transform:translateY(-50%);max-width:26ch}
  .sk .beat h2{font-size:clamp(1.9rem,4vw,3rem);font-weight:600;letter-spacing:-.03em;line-height:1.08;margin:0 0 .45em}
  .sk .beat p{font-size:clamp(1.05rem,1.7vw,1.3rem);color:var(--muted);line-height:1.5;margin:0;max-width:40ch}
  .sk .b2{opacity:0}
  .sk .art{position:relative;height:min(86vh,780px);display:flex;align-items:center;justify-content:center}
  .sk .art img{position:absolute;height:100%;width:auto;max-width:100%;object-fit:contain;mix-blend-mode:multiply;filter:saturate(1.03) contrast(1.02)}
  .sk .art [data-img2]{opacity:0}
  @keyframes skA{50%{transform:translate(26%,22%) scale(1.18)}}
  @keyframes skB{50%{transform:translate(20%,-18%) scale(1.14)}}
  @keyframes skC{50%{transform:translate(16%,18%) scale(1.2)}}
  @media(max-width:880px){
    .sk{height:auto}
    .sk .pin{position:static;height:auto;padding:12vh 0}
    .sk .grid{grid-template-columns:1fr;gap:6vh}
    .sk .txt{min-height:auto}
    .sk .beat{position:static;transform:none!important;max-width:none;opacity:1!important}
    .sk .b2{margin-top:4vh}
    .sk .art{height:auto}
    .sk .art img{position:static;height:auto;max-height:66vh}
    .sk .art [data-img2]{display:none}
  }
  @media(prefers-reduced-motion:reduce){.sk .ambient .gb{animation:none!important}}

  /* ===== MAKE THE SHIFT â€” grey card, black text, black circular growing period ===== */
  .shiftcard{position:relative;height:320vh;background:var(--paper)}
  .shiftcard .pin{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;align-items:center;
    justify-content:center;background:var(--paper)}
  .shiftcard .card{position:relative;z-index:2;width:min(1120px,92%);min-height:min(74vh,620px);border-radius:26px;
    padding:clamp(38px,5.5vw,80px);display:flex;flex-direction:column;justify-content:center;overflow:hidden;
    background:radial-gradient(130% 130% at 72% 24%, #E7E2D8 0%, #D2CCC0 78%);
    box-shadow:0 1px 2px rgba(20,19,17,.05),0 44px 100px rgba(20,19,17,.16)}
  .shiftcard .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--muted);margin:0 0 clamp(18px,3vh,30px)}
  .shiftcard .line{margin:0;font-weight:700;letter-spacing:-.05em;line-height:.9;color:var(--ink);
    font-size:clamp(3rem,9vw,7.6rem)}
  .shiftcard .line .serif{font-weight:400}
  .shiftcard .line .period{display:inline-block;width:.15em;height:.15em;position:relative;vertical-align:baseline;margin-left:.03em}
  .shiftcard .line .pdot{position:absolute;inset:0;border-radius:50%;background:var(--ink)}
  .shiftcard .sub{font-size:clamp(1.1rem,1.9vw,1.45rem);color:var(--muted);line-height:1.4;max-width:46ch;
    margin:clamp(20px,3vh,34px) 0 0}
  .shiftcard .sub .serif{font-family:var(--serif);font-style:italic;color:var(--orange-deep)}
  /* vector clip-path wipe â€” razor-sharp at any size, grows from the period */
  .shiftcard .wipe{position:absolute;inset:0;background:var(--ink);z-index:20;pointer-events:none;
    --wr:0px;--wx:50%;--wy:50%;clip-path:circle(var(--wr) at var(--wx) var(--wy));will-change:clip-path}
  @media(max-width:880px){
    .shiftcard{height:auto}
