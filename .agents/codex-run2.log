---JS---

  (function () {
    const sec = document.querySelector('[data-sketch]');
    if (!sec) return;
    const b1 = sec.querySelector('[data-beat1]');
    const b2 = sec.querySelector('[data-beat2]');
    const img1 = sec.querySelector('[data-img1]');
    const img2 = sec.querySelector('[data-img2]');
    const fill = sec.querySelector('[data-fill]');
    const cl = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    function upd() {
      const mob = window.matchMedia('(max-width:880px)').matches || reduce;
      if (mob) { [b1, b2, img1, img2].forEach((e) => e && (e.style.opacity = '', e.style.transform = '')); if (fill) fill.style.transform = 'scaleY(1)'; return; }
      const vh = window.innerHeight;
      const total = sec.offsetHeight - vh;
      const p = cl(-sec.getBoundingClientRect().top / (total || 1));
      if (fill) fill.style.transform = 'scaleY(' + p + ')';
      // hold beat 1, crossfade to beat 2 mid-scroll, hold beat 2
      const t = cl((p - 0.42) / 0.2);
      if (b1) { b1.style.opacity = String(1 - t); b1.style.transform = 'translateY(calc(-50% + ' + (-t * 26) + 'px))'; }
      if (b2) { b2.style.opacity = String(t); b2.style.transform = 'translateY(calc(-50% + ' + ((1 - t) * 26) + 'px))'; }
      if (img1) img1.style.opacity = String(1 - t);
      if (img2) img2.style.opacity = String(t);
    }
    let ticking = false;
    const onScrollSketch = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { upd(); ticking = false; }); } };
    window.addEventListener('scroll', onScrollSketch, { passive: true });
    window.addEventListener('resize', upd);
    upd();
  })();

  /* ---- MAKE THE SHIFT card: assemble, then the black circular period grows to wipe to black ---- */
  mm.add('(min-width: 881px) and (prefers-reduced-motion: no-preference)', () => {
    const sec = document.querySelector('[data-shiftcard]');
    const pin = sec.querySelector('.pin');
    const words = gsap.utils.toArray('[data-shiftcard] .w, [data-shiftcard] .period');
    const pdot = sec.querySelector('.pdot');
    const wipe = sec.querySelector('[data-wipe]');
    // centre the clip-path circle on the period (stable during the pin)
    function placeWipe() {
      const pr = pin.getBoundingClientRect();
      const dr = pdot.getBoundingClientRect();
      gsap.set(wipe, { '--wx': (dr.left - pr.left + dr.width / 2) + 'px', '--wy': (dr.top - pr.top + dr.height / 2) + 'px' });
    }
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: sec, start: 'top top', end: 'bottom bottom', pin: pin, scrub: true,
        onRefresh: placeWipe,
      },
    });
    tl.from(words, { opacity: 0, yPercent: 60, stagger: 0.06, ease: 'power3.out', duration: 0.22 }, 0.05);
    tl.add(placeWipe, 0.38);
