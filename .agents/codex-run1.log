import Base from '../layouts/Base.astro';
import { brand, hero, look, shift, manifesto, work, chetan, closing, footer } from '../data/home.ts';
---

<Base>
  <!-- ============ NAV ============ -->
  <header class="nav" id="nav">
    <div class="wrap">
      <a class="brand" href="#top"><span class="mark"></span>{brand.name}</a>
      <nav class="nav-links">
        <a href="#work">How we work</a>
        <a href="#chetan">Meet Chetan</a>
        <a class="cta" href="#explore">Letâ€™s explore <span class="arr">â†’</span></a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- ============ HERO (animation + split copy) ============ -->
    <section class="hero-a">
      <div class="wrap">
        <div class="anim">
          <iframe id="heroAnim" src="/sketches/Thoughts-Animation-hero.html" title="A hand-drawn journey from tangled thoughts to clarity." loading="eager" scrolling="no"></iframe>
        </div>
        <div class="grid">
          <div class="head">
            <p class="kicker">{hero.kickerLine}</p>
            <h1>{hero.headBefore}<span class="accent">{hero.headAccent}{hero.headAfter}</span></h1>
          </div>
          <div class="side">
            <p class="lede" set:html={hero.ledeHtml} />
            <div class="cta">
              <a class="btn" href="#explore">Letâ€™s explore <span class="arr">â†’</span></a>
              <a class="ghost" href="#work">How we work</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SKETCH SCENE (sticky, crossfade) ============ -->
    <section class="sketch" id="look" data-sketch>
      <div class="pin">
        <div class="wrap">
          <div class="grid">
            <div class="col-text">
              <div class="fill"><i data-fill></i></div>
              <div class="step">
                <h2>Sometimes, you already know enough. Yet thereâ€™s still <em>a missing piece.</em></h2>
                <p>Something you canâ€™t quite put your finger on. It could be a conversation. A different perspective. A small decision. Or simply seeing something you thought you knew in a different way.</p>
              </div>
            </div>
            <div class="col-art">
              <div class="card flowcard">
                <span class="gblob g1"></span><span class="gblob g2"></span><span class="gblob g3"></span><span class="gblob g4"></span>
                <img src={look.sketch.src} alt={look.sketch.alt} data-img1 />
                <img src={shift.row.sketch.src} alt={shift.row.sketch.alt} data-img2 style="opacity:0" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MAKE THE SHIFT â€” grey card, black text + circular growing period ============ -->
    <section class="shiftcard" data-shiftcard>
      <div class="pin">
        <div class="card">
          <span class="eyebrow">Where the shift begins</span>
          <h2 class="line"><span class="w">Make</span> <span class="w">the</span> <span class="w serif">shift</span><span class="period"><span class="pdot"></span></span></h2>
          <p class="sub">Maybe it starts with a better question. Or a clearer observation. Perhaps you see a possibility you hadnâ€™t considered â€” <span class="serif">and thatâ€™s where the shift begins.</span></p>
        </div>
        <span class="expander" data-expander aria-hidden="true"></span>
      </div>
    </section>

    <!-- ============ MAKE THE SHIFT (dark cinematic horizontal) ============ -->
    <section class="mts is-dark" data-mts>
      <div class="pin">
        <div class="ghost" data-ghost aria-hidden="true">
          <b>A thought</b><b>A possibility</b><b>A decision</b><b>Action</b>
        </div>
        <div class="fg">
          <p class="intro" data-mts-intro>Not everything needs a new plan. Sometimes, it needs <span class="serif">a new way of looking</span> at the old one.</p>
          <p class="outro" data-mts-outro>Small shifts can change <span class="serif">what happens next.</span></p>
        </div>
        <div class="bar"><i data-mts-bar></i></div>
      </div>
    </section>

    <!-- ============ MANIFESTO (dark tail) ============ -->
    <section class="manifesto is-dark">
      <div class="wrap">
        <p class="bullet rise" data-rise>Thatâ€™s what Alpha Shift is about.</p>
        <p class="big rise" data-rise>Creating the space <span class="serif">to explore.</span></p>
        <p class="say rise" data-rise>To think differently. To see more clearly. To find what matters. And then to do something about it.</p>
      </div>
    </section>

    <!-- ============ HOW WE WORK ============ -->
    <section class="work" id="work">
      <div class="wrap">
        <span class="tag rise" data-rise>How we work</span>
        <div class="head">
          <h2 class="rise" data-rise>We start <span class="serif">where you are.</span></h2>
        </div>
        <ol>
          {work.items.map((item, i) => (
            <li class="rise" data-rise>
              <span class="no">0{i + 1}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ MEET CHETAN ============ -->
    <section class="chetan" id="chetan">
      <div class="wrap">
        <div class="grid">
          <div class="card rise" data-rise>
            <span class="mk">{chetan.portrait.mark}</span>
            <span class="glyph" aria-hidden="true">C.</span>
          </div>
          <div class="rise" data-rise>
            <span class="tag">Meet Chetan</span>
            <h2>{chetan.para}</h2>
            <p class="body">{chetan.constant}</p>
            <div class="quote"><p set:html={chetan.portrait.quoteHtml} /></div>
            <p class="body">{chetan.soft}</p>
            <a class="meet" href={chetan.link.href}>{chetan.link.label} <span class="arr">â†’</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CLOSING ============ -->
    <section class="closing" id="explore">
      <div class="wrap">
        <h2 class="rise" data-rise>{closing.headBefore}<span class="serif">{closing.headSerif}</span>{closing.headAfter}</h2>
        <p class="rise" data-rise>You donâ€™t need to have it figured out. <b>Bring the question. Bring the challenge. Bring the half-formed thought.</b> Weâ€™ll start there.</p>
        <a class="btn rise" data-rise href={closing.cta.href}>{closing.cta.label} <span class="arr">â†’</span></a>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="is-dark">
      <div class="wrap">
        <p class="say" set:html={footer.copyHtml} />
        <div class="row">
          <a class="brand" href="#top"><span class="mark"></span>{brand.name}</a>
          <nav class="flinks">
            {footer.links.map((l) => (<a href={l.href}>{l.label}</a>))}
          </nav>
          <span class="cr">{footer.copyright}</span>
        </div>
      </div>
    </footer>
  </main>
</Base>

<style>
  /* Hero variant â€” scoped to this page only (does not affect the current design). */
  .hero-a{min-height:100svh;display:flex;flex-direction:column;justify-content:center;
    padding:calc(var(--nav-h) + clamp(8px,1.6vh,18px)) 0 clamp(18px,2.6vh,34px)}
  .hero-a .wrap{width:100%}
  /* full content width; crop the animation's empty vertical margins so it isn't overly tall */
  .hero-a .anim{width:100%;aspect-ratio:1672/620;position:relative;overflow:hidden;
    margin:0 auto clamp(4px,1vh,14px)}
  .hero-a .anim iframe{position:absolute;left:0;top:50%;transform:translateY(-50%);
    width:100%;aspect-ratio:1672/941;height:auto;border:0;display:block;background:transparent}
  .hero-a .grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,5vw,64px);align-items:start}
  .hero-a .kicker{font-family:var(--mono);font-size:12.5px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--muted);display:flex;align-items:center;gap:14px;margin:0 0 clamp(12px,2vh,20px)}
  .hero-a .kicker i{width:32px;height:1px;background:var(--line)}
  .hero-a h1{font-size:clamp(2.4rem,5.4vw,4.8rem);font-weight:600;letter-spacing:-.05em;line-height:.94;margin:0}
  .hero-a h1 .accent{color:var(--orange)}
  .hero-a .side{padding-bottom:.35em}
  .hero-a .lede{font-size:clamp(1.05rem,1.5vw,1.3rem);color:var(--muted);line-height:1.55;max-width:46ch;
    margin:0 0 clamp(22px,3vh,32px)}
  .hero-a .cta{display:flex;flex-wrap:wrap;gap:18px;align-items:center}
  .hero-a .btn{display:inline-flex;align-items:center;gap:.5em;background:var(--orange);color:#141311;font-weight:600;
    font-size:1.02rem;padding:15px 30px;border-radius:999px;box-shadow:0 10px 28px rgba(232,85,26,.26);
    transition:transform .2s,box-shadow .2s}
  .hero-a .btn:hover{transform:translateY(-2px);box-shadow:0 16px 38px rgba(232,85,26,.34)}
  .hero-a .btn .arr{transition:transform .2s}
  .hero-a .btn:hover .arr{transform:translateX(4px)}
  .hero-a .ghost{font-weight:500;color:var(--ink);border-bottom:1px solid var(--line);padding-bottom:2px}
  .hero-a .ghost:hover{border-color:var(--ink)}
  @media(max-width:860px){
    .hero-a{min-height:auto;padding-top:calc(var(--nav-h) + 20px)}
    .hero-a .anim{aspect-ratio:1672/720}
    .hero-a .grid{grid-template-columns:1fr;gap:22px;align-items:start}
    .hero-a h1{font-size:clamp(2.4rem,10vw,3.6rem)}
  }

  /* fix the dead-scroll wait: shorter sketch scene in this variant */
  .sketch{height:190vh}

  /* flowing warm mesh-gradient behind the sketch (Clockout-style) */
  .flowcard{overflow:hidden;background:#F0E8DC}
  .flowcard .gblob{position:absolute;border-radius:50%;filter:blur(52px);z-index:0;animation-play-state:paused}
  .flowcard.live .gblob{animation-play-state:running}
  .flowcard .g1{width:78%;height:78%;background:var(--orange);opacity:.46;left:-18%;top:-14%;animation:flowA 11s ease-in-out infinite}
  .flowcard .g2{width:82%;height:82%;background:var(--yellow);opacity:.78;left:18%;top:8%;animation:flowB 13s ease-in-out infinite}
  .flowcard .g3{width:70%;height:70%;background:var(--lavender);opacity:.62;right:-16%;bottom:-16%;animation:flowC 15s ease-in-out infinite}
  .flowcard .g4{width:66%;height:66%;background:var(--green);opacity:.6;left:-12%;bottom:-12%;animation:flowD 12s ease-in-out infinite}
  .flowcard img{z-index:2}
  @keyframes flowA{50%{transform:translate(34%,30%) scale(1.22)}}
  @keyframes flowB{50%{transform:translate(-26%,24%) scale(1.12)}}
  @keyframes flowC{50%{transform:translate(-30%,-24%) scale(1.2)}}
  @keyframes flowD{50%{transform:translate(28%,-20%) scale(1.14)}}
  @media(prefers-reduced-motion:reduce){.flowcard .gblob{animation:none!important}}

  /* ===== MAKE THE SHIFT â€” grey card, black text, black circular growing period ===== */
  .shiftcard{position:relative;height:230vh;background:var(--paper)}
  .shiftcard .pin{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;align-items:center;
    justify-content:center;background:var(--paper)}
  .shiftcard .card{position:relative;z-index:2;width:min(1120px,92%);min-height:min(74vh,620px);border-radius:26px;
    padding:clamp(38px,5.5vw,80px);display:flex;flex-direction:column;justify-content:center;overflow:hidden;
    background:radial-gradient(130% 130% at 72% 24%, #E7E2D8 0%, #D2CCC0 78%);
    box-shadow:0 1px 2px rgba(20,19,17,.05),0 44px 100px rgba(20,19,17,.16)}
  .shiftcard .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--muted);margin:0 0 clamp(18px,3vh,30px)}
  .shiftcard .line{margin:0;font-weight:700;letter-spacing:-.05em;line-height:.9;color:var(--ink);
    font-size:clamp(3rem,9vw,7.6rem)}
  .shiftcard .line .serif{font-weight:400}
  .shiftcard .line .period{display:inline-block;width:.15em;height:.15em;position:relative;vertical-align:baseline;margin-left:.03em}
  .shiftcard .line .pdot{position:absolute;inset:0;border-radius:50%;background:var(--ink)}
  .shiftcard .sub{font-size:clamp(1.1rem,1.9vw,1.45rem);color:var(--muted);line-height:1.4;max-width:46ch;
    margin:clamp(20px,3vh,34px) 0 0}
  .shiftcard .sub .serif{font-family:var(--serif);font-style:italic;color:var(--orange-deep)}
  .shiftcard .expander{position:absolute;left:50%;top:50%;width:160px;height:160px;border-radius:50%;background:var(--ink);
    transform:translate(-50%,-50%) scale(0);will-change:transform;z-index:20;pointer-events:none}
  @media(max-width:880px){
    .shiftcard{height:auto}
    .shiftcard .pin{position:static;height:auto;padding:10vh 0}
    .shiftcard .card{min-height:auto}
    .shiftcard .expander{display:none}
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- preloader ---- */
  const pre = document.getElementById('preloader');
  function hidePre() {
    document.body.classList.add('loaded');
    if (pre) { pre.classList.add('done'); setTimeout(() => pre.remove(), 700); }
    ScrollTrigger.refresh();
  }
  window.addEventListener('load', () => setTimeout(hidePre, 900));
  setTimeout(hidePre, 2600);

  /* ---- nav: solid on scroll + invert over dark sections ---- */
  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  document.querySelectorAll('.is-dark').forEach((sec) => {
    ScrollTrigger.create({
      trigger: sec, start: 'top 64px', end: 'bottom 64px',
      onToggle: (s) => nav.classList.toggle('on-dark', s.isActive),
    });
  });

  /* ---- generic rise reveals ---- */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.18, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));

  /* ---- animation: hide the Pause/Replay controls and auto-loop it (file untouched) ----
     The animation plays for 22s then stops on its final frame. We hide its controls
     (keeping #replay in the DOM) and click the hidden Replay whenever it finishes,
     so it loops forever with no buttons visible. */
  const af = document.getElementById('heroAnim');
  let animLooping = false;
  function initAnim() {
    try {
      const d = af && af.contentDocument;
      if (!d) return;
      const controls = d.querySelector('.controls');
      if (controls) controls.style.display = 'none';         // hide buttons, keep them in DOM
      const replay = d.querySelector('#replay');
      const pauseBtn = d.querySelector('#pause');
      if (replay && pauseBtn && !animLooping && !reduce) {
        animLooping = true;
        setInterval(() => {
          try { if (/finished/i.test(pauseBtn.textContent || '')) replay.click(); } catch (e) {}
        }, 400);
      }
    } catch (e) {}
  }
  if (af) {
    af.addEventListener('load', () => { initAnim(); ScrollTrigger.refresh(); });
    initAnim(); setTimeout(initAnim, 800); setTimeout(initAnim, 1800);
  }
  // keep pinned scenes aligned when layout shifts (heavy iframe, fonts, resize)
  window.addEventListener('load', () => ScrollTrigger.refresh());
  let rt; window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => ScrollTrigger.refresh(), 200); });

  // PERF: halt the hero canvas loop entirely when it's scrolled off-screen,
  // so it doesn't fight the pinned scroll scenes below.
  const animBox = document.querySelector('.hero-a .anim');
  if (af && animBox) {
    const post = (m) => { try { af.contentWindow && af.contentWindow.postMessage(m, '*'); } catch (e) {} };
    new IntersectionObserver((es) => es.forEach((e) => post(e.isIntersecting ? 'as-play' : 'as-pause')),
      { rootMargin: '120px' }).observe(animBox);
  }
  // PERF: only run the blurred gradient animation while the sketch card is on-screen
  const flow = document.querySelector('.flowcard');
  if (flow) new IntersectionObserver((es) => es.forEach((e) => flow.classList.toggle('live', e.isIntersecting)),
    { rootMargin: '80px' }).observe(flow);

  /* ---- hero intro fade-ins ---- */
  if (!reduce) {
    gsap.from('.hero-a .anim', { opacity: 0, y: 24, duration: 1.1, ease: 'power2.out', delay: 0.15 });
    gsap.from('.hero-a h1', { opacity: 0, y: 30, duration: 1, ease: 'power3.out', delay: 0.32 });
    gsap.from('.hero-a .side', { opacity: 0, y: 20, duration: 0.9, ease: 'power2.out', delay: 0.5 });
  }

  const mm = gsap.matchMedia();

  /* ---- SKETCH scene: sticky, scroll-driven fill + image crossfade (single text) ---- */
  (function () {
    const sec = document.querySelector('[data-sketch]');
    if (!sec) return;
    const img1 = sec.querySelector('[data-img1]');
    const img2 = sec.querySelector('[data-img2]');
    const fill = sec.querySelector('[data-fill]');
    const cl = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    function upd() {
      const mob = window.matchMedia('(max-width:880px)').matches || reduce;
      if (mob) { [img1, img2].forEach((e) => e && (e.style.opacity = '')); if (fill) fill.style.transform = 'scaleY(1)'; return; }
      const vh = window.innerHeight;
      const total = sec.offsetHeight - vh;
      const p = cl(-sec.getBoundingClientRect().top / (total || 1));
      if (fill) fill.style.transform = 'scaleY(' + p + ')';
      // crossfade sketch1 -> sketch2, complete by ~0.85 so there's little dead scroll
      const t = cl((p - 0.2) / 0.55);
      if (img1) img1.style.opacity = String(1 - cl((t - 0.1) * 1.5));
      if (img2) img2.style.opacity = String(cl((t - 0.25) * 1.6));
    }
    // rAF-throttle so we never read+write layout synchronously on the scroll event (no thrash)
    let ticking = false;
    const onScrollSketch = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { upd(); ticking = false; }); } };
    window.addEventListener('scroll', onScrollSketch, { passive: true });
    window.addEventListener('resize', upd);
    upd();
  })();

  /* ---- MAKE THE SHIFT card: assemble, then the black circular period grows to wipe to black ---- */
  mm.add('(min-width: 881px) and (prefers-reduced-motion: no-preference)', () => {
    const sec = document.querySelector('[data-shiftcard]');
    const pin = sec.querySelector('.pin');
    const words = gsap.utils.toArray('[data-shiftcard] .w, [data-shiftcard] .period');
    const pdot = sec.querySelector('.pdot');
    const exp = sec.querySelector('[data-expander]');
    function placeExp() {
      const pr = pin.getBoundingClientRect();
      const dr = pdot.getBoundingClientRect();
      exp.style.left = (dr.left - pr.left + dr.width / 2) + 'px';
      exp.style.top = (dr.top - pr.top + dr.height / 2) + 'px';
    }
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: sec, start: 'top top', end: 'bottom bottom', pin: pin, scrub: true,
        onRefresh: placeExp,
        onUpdate: (self) => nav.classList.toggle('on-dark', self.progress > 0.8),
      },
    });
    tl.from(words, { opacity: 0, yPercent: 60, stagger: 0.06, ease: 'power3.out', duration: 0.22 }, 0.05);
    tl.add(placeExp, 0.5);
    tl.to(exp, { scale: () => Math.hypot(window.innerWidth, window.innerHeight) * 2.4 / 160, ease: 'power2.in', duration: 0.42 }, 0.56);
  });

  /* ---- MAKE THE SHIFT: pin + horizontal ghost words + fg crossfade ---- */
  mm.add('(min-width: 881px) and (prefers-reduced-motion: no-preference)', () => {
    const ghost = document.querySelector('[data-ghost]');
    const intro = document.querySelector('[data-mts-intro]');
    const outro = document.querySelector('[data-mts-outro]');
    const bar = document.querySelector('[data-mts-bar]');
    const shift = () => ghost.scrollWidth - window.innerWidth * 0.9;
    const tl = gsap.timeline({
      scrollTrigger: { trigger: '[data-mts]', start: 'top top', end: 'bottom bottom', pin: '[data-mts] .pin', scrub: 0.6 },
    });
    tl.to(ghost, { x: () => -shift(), ease: 'none', duration: 1 }, 0);
    tl.to(bar, { width: '100%', ease: 'none', duration: 1 }, 0);
    tl.to(intro, { opacity: 0, y: -30, ease: 'none', duration: 0.25 }, 0.15);
    tl.fromTo(outro, { opacity: 0, y: 30 }, { opacity: 1, y: 0, ease: 'none', duration: 0.25 }, 0.55);
  });
</script>

const puppeteer = require('puppeteer-core');
const EDGE = 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe';
const OUT = process.argv[2];
(async () => {
  const b = await puppeteer.launch({ executablePath: EDGE, headless: 'new', args:['--no-sandbox','--hide-scrollbars'] });
  const p = await b.newPage();
  await p.setViewport({ width:1440, height:900, deviceScaleFactor:1 });
  await p.goto('http://localhost:4321/v5/', { waitUntil:'networkidle0', timeout:60000 });
  await new Promise(r=>setTimeout(r,3000));
  async function probe(label){
    const f = p.frames().find(fr => fr.url().includes('Thoughts-Animation'));
    if(!f){ console.log(label,'NO IFRAME'); return; }
    const info = await f.evaluate(()=>{
      const canvas=document.querySelector('#scene');
      const controls=document.querySelector('.controls');
      const pause=document.querySelector('#pause');
      return {
        canvasDisplay: canvas?getComputedStyle(canvas).display:'none',
        controlsDisplay: controls?getComputedStyle(controls).display:'gone',
        pauseText: pause?pause.textContent:'',
      };
    });
    console.log(label, JSON.stringify(info));
  }
  await probe('t=3s');
  await p.screenshot({ path: OUT+'-a.png' });
  // sample a canvas pixel hash to detect motion
  async function frameHash(){
    const f = p.frames().find(fr => fr.url().includes('Thoughts-Animation'));
    return await f.evaluate(()=>{ const c=document.querySelector('#scene'); const x=c.getContext('2d'); const d=x.getImageData(0,0,60,60).data; let s=0; for(let i=0;i<d.length;i+=97)s+=d[i]; return s; });
  }
  const h1=await frameHash(); await new Promise(r=>setTimeout(r,1500)); const h2=await frameHash();
  console.log('motion?', h1!==h2, h1, h2);
  await b.close();
})();

const puppeteer = require('puppeteer-core');
const path = require('path');
const EDGE = 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe';
const OUT = process.argv[2];
const FILE = process.argv[3] || ('file:///' + path.resolve('dist/index.html').replace(/\\/g,'/'));
(async () => {
  const browser = await puppeteer.launch({ executablePath: EDGE, headless: 'new', args: ['--no-sandbox','--hide-scrollbars'] });
  const page = await browser.newPage();
  await page.setViewport({ width: 1440, height: 900, deviceScaleFactor: 1 });
  await page.goto(FILE, { waitUntil: 'networkidle0', timeout: 60000 });
  await new Promise(r=>setTimeout(r,3000)); // let preloader clear + ScrollTrigger init
  const H = await page.evaluate(()=>document.body.scrollHeight);
  const VH = 900;
  const steps = Math.min(20, Math.ceil(H/(VH*0.85)));
  for(let i=0;i<steps;i++){
    await page.evaluate(y=>window.scrollTo(0,y), Math.round(i*VH*0.85));
    await new Promise(r=>setTimeout(r,600));
    await page.screenshot({ path: `${OUT}-${String(i).padStart(2,'0')}.png` });
  }
  console.log('docHeight', H, 'shots', steps);
  await browser.close();
})();

const puppeteer = require('puppeteer-core');
const EDGE = 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe';
const OUT = process.argv[2];
(async () => {
  const b = await puppeteer.launch({ executablePath: EDGE, headless: 'new', args:['--no-sandbox','--hide-scrollbars'] });
  const p = await b.newPage();
  await p.setViewport({ width:1440, height:900, deviceScaleFactor:1 });
  await p.goto('http://localhost:4321/v5/', { waitUntil:'networkidle0', timeout:60000 });
  await new Promise(r=>setTimeout(r,3000));
  const info = await p.evaluate(() => {
    const el = document.querySelector('.shiftcard');
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, height: el.offsetHeight, vh: window.innerHeight };
  });
  const usable = info.height - info.vh;
  const points = [0.1, 0.4, 0.62, 0.78, 0.95];
  for (let i=0;i<points.length;i++){
    await p.evaluate(v=>window.scrollTo(0,v), Math.round(info.top + usable*points[i]));
    await new Promise(r=>setTimeout(r,450));
    await p.screenshot({ path: `${OUT}-${i}_p${Math.round(points[i]*100)}.png` });
  }
  console.log('shiftcard top', Math.round(info.top), 'height', info.height);
  await b.close();
})();


