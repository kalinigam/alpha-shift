        </div>
      </div>
    </section>

    <!-- ============ MEET CHETAN â€” text (left) + portrait placeholder & ghost CTA (right) ============ -->
    <section class="chetan2" id="chetan">
      <div class="wrap">
        <div class="grid">
          <div class="col-l rise" data-rise>
            <span class="tag">{chetan.heading}</span>
            <p class="intro">{chetan.para} {chetan.constant}</p>
            <blockquote class="quote" set:html={chetan.portrait.quoteHtml} />
          </div>
          <div class="col-r rise" data-rise>
            <div class="portrait"><span class="ph">Portrait â€” to come</span></div>
            <p class="sub">{chetan.soft}</p>
            <a class="meet" href={chetan.link.href}>{chetan.link.label} <span class="arr">â†’</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CLOSING â€” dark, centred ============ -->
    <section class="closing2 is-dark" id="explore">
      <div class="wrap">
        <span class="tag">Ready to explore?</span>
        <h2>You donâ€™t need to <span class="serif">have it figured out.</span></h2>
        <p>Bring the question. Bring the challenge. Bring the half-formed thought. Weâ€™ll start there.</p>
        <div class="ctas">
          <a class="btn" href="#explore">Letâ€™s explore <span class="arr">â†’</span></a>
          <a class="ghost" href="#chetan">Meet Chetan</a>
        </div>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer>
      <div class="wrap">
        <p class="say" set:html={footer.copyHtml} />
        <div class="row">
          <a class="brand" href="#top"><span class="mark"></span>{brand.name}</a>
          <nav class="flinks">
            {footer.links.map((l) => (<a href={l.href}>{l.label}</a>))}
          </nav>
