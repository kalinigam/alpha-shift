          <h2 class="head" set:html={manifesto.headHtml} />
          <p class="sub">{manifesto.para}</p>
        </div>
      </div>
    </section>

    <!-- ============ HOW WE WORK â€” container box: scrolling items (left) + sticky heading/CTA (right) ============ -->
    <!-- TODO (later, per user): animate small orange balls travelling along the .box border -->
    <section class="hww" id="work">
      <div class="wrap">
        <div class="box">
          <aside class="side">
            <div class="side-in">
              <span class="tag">{work.eyebrow}</span>
