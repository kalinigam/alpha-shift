  /* ---- MAKE THE SHIFT run: centered beats fade in to full orange (no motion); bg blackâ†’grey at "A possibility", grey stays ---- */
  mm.add('(min-width: 881px) and (prefers-reduced-motion: no-preference)', () => {
    const sec = document.querySelector('[data-shiftrun]');
    const pin = sec.querySelector('.pin');
    const runs = gsap.utils.toArray('[data-shiftrun] .run');
    const bar = sec.querySelector('[data-bar]');
    const centers = [0.09, 0.27, 0.46, 0.65, 0.85];
    const plateau = 0.045, fade = 0.12;
    const black = [20, 19, 17], grey = [210, 204, 192]; // #141311 â†’ #D2CCC0 (the card grey)
    const cl = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ss = (t) => t * t * (3 - 2 * t);
    ScrollTrigger.create({
      trigger: sec, start: 'top top', end: 'bottom bottom', pin: pin, scrub: true, invalidateOnRefresh: true,
      onUpdate: (self) => {
        const p = self.progress;
        runs.forEach((el, i) => {
          let o;
          if (i === runs.length - 1) o = cl((p - 0.76) / 0.07);            // closing beat fades in and holds
          else { const d = Math.abs(p - centers[i]); o = d <= plateau ? 1 : cl(1 - (d - plateau) / fade); }
          el.style.opacity = String(o);
        });
        // black â†’ grey as "A possibility becomes a decision." reaches centre; grey stays
        const gT = ss(cl((p - 0.44) / 0.09));
        const c = black.map((b, k) => Math.round(b + (grey[k] - b) * gT));
        pin.style.setProperty('--sr-bg', 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')');
        if (bar) bar.style.width = (p * 100) + '%';
      },
    });
  });
